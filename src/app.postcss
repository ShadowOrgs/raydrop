}
:root[data-theme="cyberpunk"] .border-slate-800 {
  border-color: rgba(168, 85, 247, 0.35) !important;
}

:root[data-theme="light"] {
  filter: invert(0.93) hue-rotate(180deg);
}
:root[data-theme="light"] img,
:root[data-theme="light"] video,
:root[data-theme="light"] canvas {
  filter: invert(1) hue-rotate(180deg);
}
:root[data-theme="light"] button {
  background-image: none !important;
  border-color: transparent !important;
}
:root[data-theme="light"] button[class*="from-cyan-"],
:root[data-theme="light"] button[class*="from-indigo-"],
:root[data-theme="light"] button[class*="from-emerald-"],
:root[data-theme="light"] button[class*="bg-cyan-500"],
:root[data-theme="light"] button[class*="bg-cyan-600"],
:root[data-theme="light"] button[class*="bg-indigo-600"],
:root[data-theme="light"] button[class*="bg-emerald-500"]:not([class*="bg-emerald-500/"]),
:root[data-theme="light"] button[class*="bg-emerald-600"],
:root[data-theme="light"] button[class*="bg-amber-500"]:not([class*="bg-amber-500/"]) {
  filter: invert(1) hue-rotate(180deg);
  background-color: #0078e8 !important;
  color: #ffffff !important;
}
