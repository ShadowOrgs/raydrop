}
:root[data-theme="light"] button[class*="from-cyan-"]:hover,
:root[data-theme="light"] button[class*="from-indigo-"]:hover,
:root[data-theme="light"] button[class*="from-emerald-"]:hover,
:root[data-theme="light"] button[class*="bg-cyan-500"]:hover,
