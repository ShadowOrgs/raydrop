/* Borderless, matte Carbon Azure buttons + pure white text & icon on active blue buttons */
:root[data-theme="azure"] button:not(.border-dashed) {
  border-color: transparent !important;
}
:root[data-theme="azure"] button[class*="bg-slate-800"],
:root[data-theme="azure"] button[class*="bg-slate-900"] {
  background-color: #1f1f24 !important;
  color: #f4f4f5 !important;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
}
:root[data-theme="azure"] button[class*="bg-slate-800"]:hover,
:root[data-theme="azure"] button[class*="bg-slate-900"]:hover {
  background-color: #292930 !important;
}
:root[data-theme="azure"] button[class*="from-cyan-"],
:root[data-theme="azure"] button[class*="from-indigo-"],
:root[data-theme="azure"] button[class*="from-emerald-"],
:root[data-theme="azure"] button[class*="bg-cyan-500"],
:root[data-theme="azure"] button[class*="bg-cyan-600"],
:root[data-theme="azure"] button[class*="bg-indigo-600"],
:root[data-theme="azure"] button[class*="bg-emerald-500"]:not([class*="bg-emerald-500/"]),
:root[data-theme="azure"] button[class*="bg-emerald-600"],
:root[data-theme="azure"] button[class*="bg-amber-500"]:not([class*="bg-amber-500/"]) {
  background-image: none !important;
  background-color: #0078e8 !important;
  color: #ffffff !important;
  font-weight: 600;
}
