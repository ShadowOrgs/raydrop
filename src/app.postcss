@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  h1, h2, h3, h4 {
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
  }
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: rgba(15, 23, 42, 0.4);
  }
  ::-webkit-scrollbar-thumb {
    background: rgba(51, 65, 85, 0.6);
    border-radius: 9999px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: rgba(56, 189, 248, 0.6);
  }
}

@keyframes drift {
  0% { transform: translate3d(0, 0, 0) scale(1); }
  50% { transform: translate3d(4vw, 3vh, 0) scale(1.06); }
  100% { transform: translate3d(-3vw, 5vh, 0) scale(0.96); }
}

.ambient-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  pointer-events: none;
  animation: drift 28s ease-in-out infinite alternate;
}

/* Syntax Highlighting for Chat Code Blocks */
.raydrop-code-block .tok-kw {
  color: #c084fc;
  font-weight: 600;
}
.raydrop-code-block .tok-str {
  color: #34d399;
}
.raydrop-code-block .tok-com {
  color: #64748b;
  font-style: italic;
}
.raydrop-code-block .tok-num {
  color: #fbbf24;
}

/* Custom Theme Overrides */
:root[data-theme="oled"] body,
:root[data-theme="oled"] .bg-slate-950,
:root[data-theme="oled"] .bg-slate-950\/90,
:root[data-theme="oled"] .bg-slate-950\/60,
:root[data-theme="oled"] .bg-slate-900 {
  background-color: #000000 !important;
}

:root[data-theme="cyberpunk"] body,
:root[data-theme="cyberpunk"] .bg-slate-950 {
  background-color: #0c0618 !important;
}
:root[data-theme="cyberpunk"] .bg-slate-900,
:root[data-theme="cyberpunk"] .bg-slate-900\/90,
:root[data-theme="cyberpunk"] .bg-slate-900\/80 {
  background-color: rgba(24, 11, 48, 0.92) !important;
}
:root[data-theme="cyberpunk"] .border-slate-800 {
  border-color: rgba(168, 85, 247, 0.35) !important;
}

:root[data-theme="light"] {
  filter: invert(0.93) hue-rotate(180deg);
}
:root[data-theme="light"] img,
:root[data-theme="light"] video,
:root[data-theme="light"] canvas {
  filter: invert(1) hue-rotate(180deg);
}

