{
  "manifest_version": 3,
  "name": "Raydrop Companion — Downloader & Web Debugger",
  "short_name": "Raydrop",
  "version": "1.1.1",
  "description": "Accelerate web downloads into Raydrop and run on-demand web debugging (latency, UI/responsive audit, speedtest, and flow analysis).",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "notifications",
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:45321/*",
    "http://localhost:45321/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Raydrop Download Manager"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
